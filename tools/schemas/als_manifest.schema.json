{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godotals.local/schemas/als_manifest.schema.json",
  "title": "Godot ALS exported asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "exporterVersion", "sourceEngineVersion", "sourceProjectId", "sourceContentRoot",
    "coordinateSystem", "unitScale", "skeletons", "skeletalMeshes", "staticMeshes", "animations",
    "montages", "blendSpaces", "aimOffsets", "materials", "textures", "physicsAssets", "curves",
    "configAssets", "files", "auditSummary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exporterVersion": { "type": "string", "minLength": 1 },
    "sourceEngineVersion": { "type": "string", "minLength": 1 },
    "sourceProjectId": { "type": "string", "minLength": 1 },
    "sourceContentRoot": { "type": "string", "pattern": "^/Game/" },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceHandedness", "sourceUpAxis", "targetHandedness", "targetUpAxis"],
      "properties": {
        "sourceHandedness": { "const": "left" },
        "sourceUpAxis": { "const": "Z" },
        "targetHandedness": { "const": "right" },
        "targetUpAxis": { "const": "Y" }
      }
    },
    "unitScale": { "type": "number", "exclusiveMinimum": 0 },
    "skeletons": { "$ref": "#/$defs/assets" },
    "skeletalMeshes": { "$ref": "#/$defs/assets" },
    "staticMeshes": { "$ref": "#/$defs/assets" },
    "animations": {
      "type": "array",
      "items": { "$ref": "#/$defs/animationAsset" }
    },
    "montages": { "$ref": "#/$defs/assets" },
    "blendSpaces": { "$ref": "#/$defs/assets" },
    "aimOffsets": { "$ref": "#/$defs/assets" },
    "materials": { "$ref": "#/$defs/assets" },
    "textures": { "$ref": "#/$defs/assets" },
    "physicsAssets": { "$ref": "#/$defs/assets" },
    "curves": { "$ref": "#/$defs/assets" },
    "configAssets": { "$ref": "#/$defs/assets" },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file" }
    },
    "auditSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assetCount", "fileCount", "errorCount", "warningCount"],
      "properties": {
        "status": { "enum": ["planned", "complete", "failed"] },
        "assetCount": { "type": "integer", "minimum": 0 },
        "fileCount": { "type": "integer", "minimum": 0 },
        "errorCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objectPath", "packagePath", "assetName", "classPath", "outputPath", "dependencies", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "objectPath": { "type": "string", "pattern": "^/Game/.+\\.[^./]+$" },
        "packagePath": { "type": "string", "pattern": "^/Game/" },
        "assetName": { "type": "string", "minLength": 1 },
        "classPath": { "type": "string", "minLength": 1 },
        "outputPath": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^(meshes/(skeletal|static)|animations|textures)/[0-9a-f]{40}\\.(fbx|png|tga)$" }
          ]
        },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
        "metadata": { "type": "object" }
      }
    },
    "animationAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        {
          "properties": {
            "classPath": { "const": "/Script/Engine.AnimSequence" },
            "metadata": { "$ref": "#/$defs/animationMetadata" }
          }
        }
      ]
    },
    "animationMetadata": {
      "type": "object",
      "required": ["curves"],
      "allOf": [
        {
          "if": {
            "properties": {
              "curves": {
                "contains": {
                  "properties": { "canonicalKind": { "const": "RotationYawSpeedRadiansPerSecond" } }
                }
              }
            }
          },
          "then": {
            "required": ["canonicalRotationYawSourceConvention", "canonicalRotationYawProfileSignProvenance"],
            "properties": {
              "canonicalRotationYawSourceConvention": { "const": "ue_root_bone_rotator_yaw_degrees_z_up" },
              "canonicalRotationYawProfileSignProvenance": { "const": "runtime_profile_sign_pending" }
            }
          }
        }
      ],
      "properties": {
        "curves": {
          "type": "array",
          "items": { "$ref": "#/$defs/floatCurve" }
        },
        "canonicalRotationYawSourceConvention": { "type": "string" },
        "canonicalRotationYawProfileSignProvenance": { "type": "string" }
      }
    },
    "floatCurveKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeSeconds", "value", "interpolation", "arriveTangent", "leaveTangent"],
      "properties": {
        "timeSeconds": { "type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308 },
        "value": { "type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308 },
        "interpolation": { "enum": ["Constant", "Linear", "Cubic"] },
        "arriveTangent": { "type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308 },
        "leaveTangent": { "type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308 }
      }
    },
    "floatCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stableCurveId", "canonicalKind", "sourceName", "sourceProvenance", "preInfinity", "postInfinity", "keys"],
      "allOf": [
        {
          "if": { "properties": { "canonicalKind": { "const": "None" } } },
          "then": { "properties": { "sourceProvenance": { "const": "source_curve" } } }
        },
        {
          "if": { "properties": { "canonicalKind": { "const": "RotationYawSpeedRadiansPerSecond" } } },
          "then": {
            "properties": {
              "sourceName": { "const": "RotationYawSpeedRadiansPerSecond" },
              "sourceProvenance": { "const": "derived_root_track" },
              "preInfinity": { "const": "Constant" },
              "postInfinity": { "const": "Constant" },
              "keys": {
                "items": {
                  "properties": { "interpolation": { "const": "Linear" } }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "stableCurveId": { "type": "integer", "minimum": 0 },
        "canonicalKind": { "enum": ["None", "RotationYawSpeedRadiansPerSecond"] },
        "sourceName": { "type": "string", "minLength": 1 },
        "sourceProvenance": { "enum": ["source_curve", "derived_root_track"] },
        "preInfinity": { "enum": ["Constant", "Linear", "Cycle", "CycleWithOffset", "Oscillate"] },
        "postInfinity": { "enum": ["Constant", "Linear", "Cycle", "CycleWithOffset", "Oscillate"] },
        "keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/floatCurveKey" }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256", "size"],
      "properties": {
        "relativePath": { "type": "string", "pattern": "^(meshes/(skeletal|static)|animations|textures)/[0-9a-f]{40}\\.(fbx|png|tga)$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
