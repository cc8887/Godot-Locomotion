{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godotals.local/schemas/als_manifest.schema.json",
  "title": "Godot ALS exported asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "exporterVersion", "sourceEngineVersion", "sourceProjectId", "sourceContentRoot",
    "coordinateSystem", "unitScale", "skeletons", "skeletalMeshes", "staticMeshes", "animations",
    "montages", "blendSpaces", "aimOffsets", "materials", "textures", "physicsAssets", "curves",
    "configAssets", "files", "auditSummary"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "exporterVersion": { "type": "string", "pattern": "\\S" },
    "sourceEngineVersion": { "type": "string", "minLength": 1 },
    "sourceProjectId": { "type": "string", "minLength": 1 },
    "sourceContentRoot": { "type": "string", "pattern": "^/Game/" },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceHandedness", "sourceUpAxis", "targetHandedness", "targetUpAxis"],
      "properties": {
        "sourceHandedness": { "const": "left" },
        "sourceUpAxis": { "const": "Z" },
        "targetHandedness": { "const": "right" },
        "targetUpAxis": { "const": "Y" }
      }
    },
    "unitScale": { "type": "number", "exclusiveMinimum": 0 },
    "skeletons": { "$ref": "#/$defs/assets" },
    "skeletalMeshes": { "$ref": "#/$defs/assets" },
    "staticMeshes": { "$ref": "#/$defs/assets" },
    "animations": { "type": "array", "items": { "$ref": "#/$defs/animationAsset" } },
    "montages": { "type": "array", "items": { "$ref": "#/$defs/montageAsset" } },
    "blendSpaces": { "$ref": "#/$defs/assets" },
    "aimOffsets": { "$ref": "#/$defs/assets" },
    "materials": { "$ref": "#/$defs/assets" },
    "textures": { "$ref": "#/$defs/assets" },
    "physicsAssets": { "$ref": "#/$defs/assets" },
    "curves": { "$ref": "#/$defs/assets" },
    "configAssets": { "$ref": "#/$defs/assets" },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "auditSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assetCount", "fileCount", "errorCount", "warningCount"],
      "properties": {
        "status": { "enum": ["planned", "complete", "failed"] },
        "assetCount": { "type": "integer", "minimum": 0 },
        "fileCount": { "type": "integer", "minimum": 0 },
        "errorCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "finiteFloat": {
      "type": "number",
      "minimum": -3.4028234663852886e38,
      "maximum": 3.4028234663852886e38
    },
    "nonnegativeFiniteFloat": {
      "type": "number",
      "minimum": 0,
      "maximum": 3.4028234663852886e38
    },
    "stableId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objectPath", "packagePath", "assetName", "classPath", "outputPath", "dependencies", "metadata"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "objectPath": { "type": "string", "pattern": "^/Game/.+\\.[^./]+$" },
        "packagePath": { "type": "string", "pattern": "^/Game/" },
        "assetName": { "type": "string", "minLength": 1 },
        "classPath": { "type": "string", "minLength": 1 },
        "outputPath": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^(meshes/(skeletal|static)|animations|textures)/[0-9a-f]{40}\\.(fbx|png|tga)$" }
          ]
        },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
        "metadata": { "type": "object" }
      }
    },
    "animationAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        {
          "properties": {
            "classPath": { "const": "/Script/Engine.AnimSequence" },
            "metadata": { "$ref": "#/$defs/animationMetadata" }
          }
        }
      ]
    },
    "montageAsset": {
      "allOf": [
        { "$ref": "#/$defs/asset" },
        {
          "properties": {
            "classPath": { "const": "/Script/Engine.AnimMontage" },
            "metadata": { "$ref": "#/$defs/montageMetadata" }
          }
        }
      ]
    },
    "animationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay", "prop", "playLength", "frameRateNumerator", "frameRateDenominator", "sampledKeyCount",
        "loop", "interpolation", "rootMotionEnabled", "rootMotionRootLock", "forceRootLock",
        "useNormalizedRootMotionScale", "additiveType", "additiveBasePoseType", "additiveBasePoseFrame",
        "additiveBasePoseObjectPath", "additiveBasePoseId", "skeletonId", "skeletonObjectPath",
        "curves", "timeline", "syncMarkers"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "curves": {
                "contains": { "properties": { "canonicalKind": { "const": "RotationYawSpeedRadiansPerSecond" } } }
              }
            }
          },
          "then": {
            "required": ["canonicalRotationYawSourceConvention", "canonicalRotationYawProfileSignProvenance"],
            "properties": {
              "canonicalRotationYawSourceConvention": { "const": "ue_root_bone_rotator_yaw_degrees_z_up" },
              "canonicalRotationYawProfileSignProvenance": { "const": "runtime_profile_sign_pending" }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["canonicalRotationYawSourceConvention"] },
                { "required": ["canonicalRotationYawProfileSignProvenance"] }
              ]
            }
          }
        }
      ],
      "properties": {
        "overlay": { "type": "boolean" },
        "prop": { "type": "boolean" },
        "playLength": { "$ref": "#/$defs/nonnegativeFiniteFloat" },
        "frameRateNumerator": { "type": "integer", "minimum": 1 },
        "frameRateDenominator": { "type": "integer", "minimum": 1 },
        "sampledKeyCount": { "type": "integer", "minimum": 0 },
        "loop": { "type": "boolean" },
        "interpolation": { "type": "integer" },
        "rootMotionEnabled": { "type": "boolean" },
        "rootMotionRootLock": { "type": "integer" },
        "forceRootLock": { "type": "boolean" },
        "useNormalizedRootMotionScale": { "type": "boolean" },
        "additiveType": { "type": "integer" },
        "additiveBasePoseType": { "type": "integer" },
        "additiveBasePoseFrame": { "type": "integer" },
        "additiveBasePoseObjectPath": { "type": "string" },
        "additiveBasePoseId": { "type": "string", "pattern": "^$|^[0-9a-f]{40}$" },
        "skeletonId": { "$ref": "#/$defs/stableId" },
        "skeletonObjectPath": { "type": "string", "minLength": 1 },
        "curves": { "type": "array", "items": { "$ref": "#/$defs/floatCurve" } },
        "timeline": { "type": "array", "items": { "$ref": "#/$defs/timelineEvent" } },
        "syncMarkers": { "type": "array", "items": { "$ref": "#/$defs/syncMarker" } },
        "canonicalRotationYawSourceConvention": { "type": "string" },
        "canonicalRotationYawProfileSignProvenance": { "type": "string" }
      }
    },
    "timelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableEventId", "kind", "sourceClassPath", "displayName", "timeSeconds", "durationSeconds",
        "triggerWeightThreshold", "tickMode", "sourceIndex", "trackIndex", "payload"
      ],
      "oneOf": [
        { "properties": { "kind": { "const": "Generic" }, "payload": { "$ref": "#/$defs/genericPayload" } } },
        { "properties": { "kind": { "const": "Footstep" }, "payload": { "$ref": "#/$defs/footstepPayload" } } },
        { "properties": { "kind": { "const": "SetAction" }, "payload": { "$ref": "#/$defs/setActionPayload" } } },
        { "properties": { "kind": { "const": "SetGroundedEntry" }, "payload": { "$ref": "#/$defs/setGroundedEntryPayload" } } },
        { "properties": { "kind": { "const": "EarlyBlendOut" }, "payload": { "$ref": "#/$defs/earlyBlendOutPayload" } } },
        { "properties": { "kind": { "const": "RootMotionScale" }, "payload": { "$ref": "#/$defs/rootMotionScalePayload" } } }
      ],
      "properties": {
        "stableEventId": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["Generic", "Footstep", "SetAction", "SetGroundedEntry", "EarlyBlendOut", "RootMotionScale"] },
        "sourceClassPath": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "timeSeconds": { "$ref": "#/$defs/nonnegativeFiniteFloat" },
        "durationSeconds": { "$ref": "#/$defs/nonnegativeFiniteFloat" },
        "triggerWeightThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "tickMode": { "enum": ["Queued", "BranchingPoint"] },
        "sourceIndex": { "type": "integer", "minimum": 0 },
        "trackIndex": { "type": "integer", "minimum": 0 },
        "payload": { "type": "object" }
      }
    },
    "genericPayload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "footstepPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foot"],
      "properties": { "foot": { "enum": ["Unspecified", "Left", "Right"] } }
    },
    "setActionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": { "action": { "enum": ["None", "Rolling", "Mantling", "Ragdolling", "GettingUp"] } }
    },
    "setGroundedEntryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "enum": ["None", "FromRoll"] } }
    },
    "earlyBlendOutPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blendOutSeconds", "checkInput", "checkLocomotionMode", "locomotionMode",
        "checkRotationMode", "rotationMode", "checkStance", "stance"
      ],
      "properties": {
        "blendOutSeconds": { "$ref": "#/$defs/nonnegativeFiniteFloat" },
        "checkInput": { "type": "boolean" },
        "checkLocomotionMode": { "type": "boolean" },
        "locomotionMode": { "enum": ["Grounded", "InAir", "Mantling", "Ragdoll", "Recovering"] },
        "checkRotationMode": { "type": "boolean" },
        "rotationMode": { "enum": ["VelocityDirection", "LookingDirection", "Aiming"] },
        "checkStance": { "type": "boolean" },
        "stance": { "enum": ["Standing", "Crouching"] }
      }
    },
    "rootMotionScalePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translationScale"],
      "properties": { "translationScale": { "$ref": "#/$defs/nonnegativeFiniteFloat" } }
    },
    "syncMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stableMarkerId", "name", "timeSeconds", "sourceIndex", "trackIndex"],
      "properties": {
        "stableMarkerId": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "timeSeconds": { "$ref": "#/$defs/nonnegativeFiniteFloat" },
        "sourceIndex": { "type": "integer", "minimum": 0 },
        "trackIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "montageMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay", "prop", "sections", "slots", "playLength", "blendInTime", "blendInOption",
        "blendOutTime", "blendOutOption", "blendOutTriggerTime", "enableAutoBlendOut", "timeline"
      ],
      "properties": {
        "overlay": { "type": "boolean" },
        "prop": { "type": "boolean" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/montageSection" } },
        "slots": { "type": "array", "items": { "$ref": "#/$defs/montageSlot" } },
        "playLength": { "$ref": "#/$defs/nonnegativeFiniteFloat" },
        "blendInTime": { "$ref": "#/$defs/nonnegativeFiniteFloat" },
        "blendInOption": { "type": "integer" },
        "blendOutTime": { "$ref": "#/$defs/nonnegativeFiniteFloat" },
        "blendOutOption": { "type": "integer" },
        "blendOutTriggerTime": { "$ref": "#/$defs/finiteFloat" },
        "enableAutoBlendOut": { "type": "boolean" },
        "timeline": { "type": "array", "items": { "$ref": "#/$defs/timelineEvent" } }
      }
    },
    "montageSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "nextSection", "startTime"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "nextSection": { "type": "string", "not": { "const": "None" } },
        "startTime": { "$ref": "#/$defs/nonnegativeFiniteFloat" }
      }
    },
    "montageSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotName", "segments"],
      "properties": {
        "slotName": { "type": "string", "minLength": 1 },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/montageSegment" } }
      }
    },
    "montageSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "animationId", "animationObjectPath", "startPosition", "animationStartTime", "animationEndTime",
        "playRate", "loopCount"
      ],
      "properties": {
        "animationId": { "$ref": "#/$defs/stableId" },
        "animationObjectPath": { "type": "string", "minLength": 1 },
        "startPosition": { "$ref": "#/$defs/nonnegativeFiniteFloat" },
        "animationStartTime": { "$ref": "#/$defs/nonnegativeFiniteFloat" },
        "animationEndTime": { "$ref": "#/$defs/nonnegativeFiniteFloat" },
        "playRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 3.4028234663852886e38 },
        "loopCount": { "type": "integer", "minimum": 1 }
      }
    },
    "floatCurveKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeSeconds", "value", "interpolation", "arriveTangent", "leaveTangent"],
      "properties": {
        "timeSeconds": { "$ref": "#/$defs/finiteFloat" },
        "value": { "$ref": "#/$defs/finiteFloat" },
        "interpolation": { "enum": ["Constant", "Linear", "Cubic"] },
        "arriveTangent": { "$ref": "#/$defs/finiteFloat" },
        "leaveTangent": { "$ref": "#/$defs/finiteFloat" }
      }
    },
    "floatCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stableCurveId", "canonicalKind", "sourceName", "sourceProvenance", "preInfinity", "postInfinity", "keys"],
      "allOf": [
        {
          "if": { "properties": { "canonicalKind": { "const": "None" } } },
          "then": { "properties": { "sourceProvenance": { "const": "source_curve" } } }
        },
        {
          "if": { "properties": { "canonicalKind": { "const": "RotationYawSpeedRadiansPerSecond" } } },
          "then": {
            "properties": {
              "sourceName": { "const": "RotationYawSpeedRadiansPerSecond" },
              "sourceProvenance": { "const": "derived_root_track" },
              "preInfinity": { "const": "Constant" },
              "postInfinity": { "const": "Constant" },
              "keys": {
                "minItems": 2,
                "prefixItems": [
                  {
                    "allOf": [
                      { "properties": { "timeSeconds": { "const": 0 } } },
                      { "properties": { "interpolation": { "const": "Linear" } } }
                    ]
                  }
                ],
                "items": { "properties": { "interpolation": { "const": "Linear" } } }
              }
            }
          }
        }
      ],
      "properties": {
        "stableCurveId": { "type": "integer", "minimum": 0 },
        "canonicalKind": { "enum": ["None", "RotationYawSpeedRadiansPerSecond"] },
        "sourceName": { "type": "string", "minLength": 1 },
        "sourceProvenance": { "enum": ["source_curve", "derived_root_track"] },
        "preInfinity": { "enum": ["Constant", "Linear", "Cycle", "CycleWithOffset", "Oscillate"] },
        "postInfinity": { "enum": ["Constant", "Linear", "Cycle", "CycleWithOffset", "Oscillate"] },
        "keys": { "type": "array", "items": { "$ref": "#/$defs/floatCurveKey" } }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256", "size"],
      "properties": {
        "relativePath": { "type": "string", "pattern": "^(meshes/(skeletal|static)|animations|textures)/[0-9a-f]{40}\\.(fbx|png|tga)$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
