# Copy to .env.local.ps1, fill in machine-local paths, then dot-source it.
$env:GODOT_ALS_ROOT = $PSScriptRoot
$env:ALS_UE_PROJECT_ROOT = ''
$env:ALS_UE_PROJECT_FILE = if ($env:ALS_UE_PROJECT_ROOT) {
    Join-Path $env:ALS_UE_PROJECT_ROOT 'AdvancedLocomotionSystemV.uproject'
} else {
    ''
}
$env:UE_ENGINE_ROOT = ''
$env:ALS_REFERENCE_ROOT = ''
$env:GODOT_EXECUTABLE = ''
