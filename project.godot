; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot ALS"
run/main_scene="res://scenes/demo/als_demo.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dotnet]

project/assembly_name="GodotALS"

[editor_plugins]

enabled=PackedStringArray("res://addons/als_importer/plugin.cfg")

[importer_defaults]

scene={
"animation/fps": 30,
"animation/import": true,
"fbx/embedded_image_handling": 0
}

